{
	"name": "quiz-backend",
	"version": "0.1.0",
	"private": true,
	"engines": {
		"node": ">=22.12"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"lint": "eslint src prisma",
		"typecheck": "tsc --noEmit",
		"start": "node dist/main.js",
		"start:dev": "node --watch -r ts-node/register src/main.ts",
		"db:generate": "prisma generate",
		"db:deploy": "prisma migrate deploy",
		"db:dev": "prisma migrate dev",
		"admin:grant": "tsx prisma/grant-admin.ts",
		"test:e2e": "node --test test/backend.e2e.cjs",
		"topik:import": "tsx --env-file-if-exists=.env prisma/import-topik.ts",
		"mock:import": "tsx --env-file-if-exists=.env prisma/import-mock.ts",
		"vocabulary:import": "tsx --env-file-if-exists=.env prisma/import-vocabulary.ts"
	},
	"dependencies": {
		"@apollo/server": "^5.0.0",
		"@as-integrations/express5": "^1.1.2",
		"@aws-sdk/client-s3": "^3.850.0",
		"@aws-sdk/s3-request-presigner": "^3.850.0",
		"@nestjs/apollo": "^13.2.0",
		"@nestjs/common": "^11.1.0",
		"@nestjs/config": "^4.0.2",
		"@nestjs/core": "^11.1.0",
		"@nestjs/graphql": "^13.2.0",
		"@nestjs/jwt": "^11.0.0",
		"@nestjs/platform-express": "^11.1.0",
		"@nestjs/schedule": "^6.0.0",
		"@prisma/client": "6.19.3",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.14.2",
		"cookie-parser": "^1.4.7",
		"graphql": "^16.11.0",
		"jsonwebtoken": "^9.0.2",
		"nodemailer": "^8.0.0",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2"
	},
	"devDependencies": {
		"@types/cookie-parser": "^1.4.8",
		"@types/express": "^5.0.3",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^24.0.0",
		"@types/nodemailer": "^7.0.0",
		"eslint": "^9.0.0",
		"prettier": "^3.0.0",
		"prisma": "6.19.3",
		"ts-node": "10.9.2",
		"tsx": "^4.20.0",
		"typescript": "~5.9.0",
		"typescript-eslint": "^8.0.0"
	}
}
